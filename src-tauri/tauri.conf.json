{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trapped",
  "identifier": "com.trapped.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trapped",
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0a1628",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NDNFRDM0MDExMzlFOEEKUldTS25oTUJOTzFEUmJVVmRuVHQxT2NmVjhYbzlzWHpiWmp0blFFakNYY1lZS0lSUHZBbkNNaW4K",
      "endpoints": ["https://github.com/dragonofmercy/trapped/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
